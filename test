    regex: &#x27;(?i)(biometrics?|voice[_-]?print|palm[_-]?print|face[_-]?id|iris[_ -]?scan|minutiae)\b&#x27;

  - id: pii-biometric-format
    category: BiometricData
    title: Biometric format/standard reference (WSQ, ISO 19794, NIST-ITL, CBEFF)
    severity: MEDIUM
    keywords: [&quot;wsq&quot;, &quot;19794&quot;, &quot;NIST-ITL&quot;, &quot;NISTITL&quot;, &quot;CBEFF&quot;]
    regex: &#x27;(?i)(\.wsq\b|ISO[/ ]?19794|ANSI[/ ]?NIST[- ]?ITL|NIST[- ]?ITL|CBEFF)&#x27;

  - id: pii-email
    category: BiographicData
    title: Email address
    severity: MEDIUM
    regex: &#x27;[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}&#x27;

  - id: pii-dob
    category: BiographicData
    title: Date of birth (labeled)
    severity: HIGH
    keywords: [&quot;dob&quot;, &quot;birth&quot;]
    regex: &#x27;(?i)(dob|date[_ ]?of[_ ]?birth|birth[_-]?date)\s*[:=]\s*\S+&#x27;</code></pre>

