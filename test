ALB_DIM=$(echo "<YOUR_LOAD_BALANCER_ARN>" | sed 's#.*:loadbalancer/##')
echo "$ALB_DIM"

START=$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ)
END=$(date -u +%Y-%m-%dT%H:%M:%SZ)

echo "== 5XX returned by the tasks =="
aws cloudwatch get-metric-statistics --namespace AWS/ApplicationELB \
  --metric-name HTTPCode_Target_5XX_Count \
  --dimensions Name=LoadBalancer,Value="$ALB_DIM" \
  --start-time "$START" --end-time "$END" \
  --period 300 --statistics Sum \
  --query 'sort_by(Datapoints,&Timestamp)[].[Timestamp,Sum]' --output table

echo "== 5XX generated by the load balancer =="
aws cloudwatch get-metric-statistics --namespace AWS/ApplicationELB \
  --metric-name HTTPCode_ELB_5XX_Count \
  --dimensions Name=LoadBalancer,Value="$ALB_DIM" \
  --start-time "$START" --end-time "$END" \
  --period 300 --statistics Sum \
  --query 'sort_by(Datapoints,&Timestamp)[].[Timestamp,Sum]' --output table
