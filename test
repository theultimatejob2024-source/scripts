# trivy-dna.yaml — DNA / genetic-data references in logs.
# Use: trivy fs --scanners secret --secret-config trivy-dna.yaml <path>
# Raw genetic data normally lives in files, so these match the REFERENCES that
# appear as text: genomic file paths, SNP IDs, STR loci, profile/genotype
# fields, genetic terms, and raw sequence.

rules:
  - id: pii-dna-genomic-file
    category: GeneticData
    title: Genomic data file reference (VCF/BAM/CRAM/FASTQ/SAM/BCF)
    severity: HIGH
    keywords: ["vcf", "bam", "cram", "fastq", ".fq", ".sam", ".bcf"]
    regex: '(?i)[A-Za-z0-9_./-]*\.(vcf|gvcf|bcf|fastq|fq|bam|cram|sam)(\.gz)?\b'

  - id: pii-dna-snp-id
    category: GeneticData
    title: dbSNP variant identifier (rsID)
    severity: MEDIUM
    regex: '\brs[0-9]{3,}\b'

  - id: pii-dna-str-locus
    category: GeneticData
    title: Forensic STR / CODIS locus name
    severity: HIGH
    regex: '(?i)\b(D[0-9]{1,2}S[0-9]{2,4}|vWA|FGA|TH01|CSF1PO|TPOX|SE33|amelogenin)\b'

  - id: pii-dna-genetic-field
    category: GeneticData
    title: Genetic profile / genotype / allele field with a value
    severity: HIGH
    keywords: ["genotype", "allele", "dna_profile", "dna-profile", "str_profile", "str-profile"]
    regex: '(?i)((dna|str)[_-]?profile|genotype|alleles?)\s*[:=]\s*\S+'

  - id: pii-dna-genetic-term
    category: GeneticData
    title: Genetic / forensic genomics term
    severity: MEDIUM
    keywords: ["genomic", "genome", "codis", "biosample", "dna_sequence", "dna-sequence"]
    regex: '(?i)\b(genomic|genome|codis|biosample|dna[_-]?sequence)\b'

  - id: pii-dna-sequence
    category: GeneticData
    title: Raw DNA sequence (20+ bases)
    severity: HIGH
    regex: '(?i)\b[acgtn]{20,}\b'
