# trivy-pii.yaml — biometric + biographic PII only.
# Use: trivy fs --scanners secret --secret-config trivy-pii.yaml <path>

allow-rules:
  - id: example-email-domains
    regex: '@(example|test|localhost|invalid)\.'
  - id: placeholder-ssn
    regex: '(000-00-0000|123-45-6789|111-11-1111)'

rules:
  # ---------------- Biometric ----------------
  - id: pii-biometric-template-value
    category: BiometricData
    title: Biometric template/image field with a value
    severity: HIGH
    keywords: ["fingerprint", "face", "iris", "retina", "palm", "voice"]
    regex: '(?i)(fingerprint|face|iris|retina|palm|voice)[_-]?(template|image|encoding|embedding|scan|data|record|sample)\s*[:=]\s*\S+'

  - id: pii-biometric-keyword
    category: BiometricData
    title: Biometric data reference (voiceprint/palmprint/faceID/minutiae)
    severity: MEDIUM
    keywords: ["biometric", "voiceprint", "palmprint", "faceid", "iris scan", "minutiae"]
    regex: '(?i)(biometrics?|voice[_-]?print|palm[_-]?print|face[_-]?id|iris[_ -]?scan|minutiae)\b'

  - id: pii-biometric-format
    category: BiometricData
    title: Biometric format/standard reference (WSQ, ISO 19794, NIST-ITL, CBEFF)
    severity: MEDIUM
    keywords: ["wsq", "19794", "NIST-ITL", "NISTITL", "CBEFF"]
    regex: '(?i)(\.wsq\b|ISO[/ ]?19794|ANSI[/ ]?NIST[- ]?ITL|NIST[- ]?ITL|CBEFF)'

  # ---------------- Biographic ----------------
  - id: pii-email
    category: BiographicData
    title: Email address
    severity: MEDIUM
    regex: '[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}'

  - id: pii-us-ssn
    category: BiographicData
    title: US Social Security Number
    severity: HIGH
    regex: '\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b'

  - id: pii-credit-card
    category: BiographicData
    title: Payment card number (major brands)
    severity: HIGH
    regex: '\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})\b'

  - id: pii-india-pan
    category: BiographicData
    title: India PAN
    severity: HIGH
    regex: '\b[A-Z]{5}[0-9]{4}[A-Z]\b'

  - id: pii-india-aadhaar-spaced
    category: BiographicData
    title: India Aadhaar (spaced 12-digit)
    severity: HIGH
    regex: '\b[2-9][0-9]{3}\s[0-9]{4}\s[0-9]{4}\b'

  - id: pii-india-aadhaar-labeled
    category: BiographicData
    title: India Aadhaar (labeled 12-digit)
    severity: HIGH
    keywords: ["aadhaar", "aadhar", "uidai", "uid"]
    regex: '(?i)(aadha?ar|uidai?|uid)\s*(no|number|#|:|=)?\s*[2-9][0-9]{3}\s?[0-9]{4}\s?[0-9]{4}\b'

  - id: pii-uk-nino
    category: BiographicData
    title: UK National Insurance Number
    severity: HIGH
    keywords: ["NI", "nino", "national insurance"]
    regex: '\b[A-CEGHJ-PR-TW-Z]{2}[0-9]{6}[A-D]\b'

  - id: pii-passport
    category: BiographicData
    title: Passport number (labeled)
    severity: HIGH
    keywords: ["passport"]
    regex: '(?i)passport\s*(no\.?|number|num|#)?\s*[:=#]?\s*[A-Z0-9]{6,9}\b'

  - id: pii-phone
    category: BiographicData
    title: Phone / mobile number (labeled)
    severity: MEDIUM
    keywords: ["phone", "mobile", "msisdn", "tel", "contact"]
    regex: '(?i)(phone|mobile|msisdn|tel|contact)\s*(no|number|#)?\s*[:=]\s*\+?[0-9][0-9\s\-().]{7,}'

  - id: pii-dob
    category: BiographicData
    title: Date of birth (labeled)
    severity: HIGH
    keywords: ["dob", "birth"]
    regex: '(?i)(dob|date[_ ]?of[_ ]?birth|birth[_-]?date)\s*[:=]\s*\S+'

  - id: pii-drivers-license
    category: BiographicData
    title: Driver's license (labeled)
    severity: HIGH
    keywords: ["licence", "license", "driving", "dl no", "dln"]
    regex: '(?i)(driver\x27?s?[_ ]?licen[sc]e|driving[_ ]?licen[sc]e|dl[_ ]?(no|number|#))\s*[:=#]?\s*[A-Z0-9]{5,}'

  - id: pii-demographic-field
    category: BiographicData
    title: Demographic field (nationality/gender/marital/POB/maiden name)
    severity: LOW
    keywords: ["nationality", "gender", "marital", "place of birth", "maiden"]
    regex: '(?i)(nationality|gender|marital[_ -]?status|place[_ -]?of[_ -]?birth|mother[_ -]?s?[_ -]?maiden)\s*[:=]\s*\S+'
