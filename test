#!/usr/bin/env bash
#
# scan-logs-trivy.sh
#
# Scan a directory of (possibly huge) CloudWatch log files for secrets with
# Trivy, one file at a time: chunk a log into small line-whole pieces so none
# trips Trivy's "file too large" skip, scan the chunks, save the result, then
# delete the chunks before moving to the next log. Disk never holds more than
# one log's chunks at a time.
#
# Resumable: a log is recorded done only after it scans cleanly, so a re-run
# skips finished logs (handy if a run is interrupted).
#
# USAGE
#   ./scan-logs-trivy.sh [LOGDIR]            # defaults to cwlogs
#   CHUNK_SIZE=10M OUTDIR=results ./scan-logs-trivy.sh cwlogs
#
# If a trivy-secret.yaml exists (or SECRET_CONFIG points to one) it is passed
# to Trivy so your custom infra-cred rules run alongside the built-ins.
# -----------------------------------------------------------------------------
LOGDIR="${1:-${LOGDIR:-cwlogs}}"
OUTDIR="${OUTDIR:-trivy-results}"
CHUNK_SIZE="${CHUNK_SIZE:-5M}"             # whole-line chunks; stays under Trivy's limit
SECRET_CONFIG="${SECRET_CONFIG:-trivy-secret.yaml}"
CHUNK_ROOT="${CHUNK_ROOT:-$OUTDIR/.chunks}"
DONE_FILE="${DONE_FILE:-$OUTDIR/.scanned-done.txt}"

# -----------------------------------------------------------------------------
command -v trivy >/dev/null 2>&1 || { echo "ERROR: trivy not found on PATH" >&2; exit 1; }
[ -d "$LOGDIR" ] || { echo "ERROR: log dir not found: $LOGDIR" >&2; exit 1; }

mkdir -p "$OUTDIR"
touch "$DONE_FILE"

# use custom rules only if the file is actually there
CONFIG_ARG=()
if [ -f "$SECRET_CONFIG" ]; then
  CONFIG_ARG=(--secret-config "$SECRET_CONFIG")
  echo "Using custom secret rules: $SECRET_CONFIG"
else
  echo "No $SECRET_CONFIG found — built-in rules only (cloud/SaaS tokens; infra creds may be missed)."
fi
echo "Log dir: $LOGDIR | chunk size: $CHUNK_SIZE | results: $OUTDIR"
echo

# always clean up the scratch chunk dir, even on Ctrl-C
cleanup() { rm -rf "$CHUNK_ROOT"; }
trap cleanup EXIT

shopt -s nullglob
logs=("$LOGDIR"/*.log)
shopt -u nullglob
if [ "${#logs[@]}" -eq 0 ]; then
  echo "No *.log files in $LOGDIR" >&2; exit 1
fi

n_find=0; n_clean=0; n_skip=0; n_err=0
: > "$OUTDIR/.findings-index.txt"

for f in "${logs[@]}"; do
  base="$(basename "$f")"

  if grep -Fxq -- "$base" "$DONE_FILE"; then
    echo "skip (done): $base"; n_skip=$((n_skip+1)); continue
  fi

  echo "============================================================"
  echo "LOG: $base  ($(du -h "$f" | cut -f1))"

  # 1) chunk this one log into whole-line pieces
  chunkdir="$CHUNK_ROOT/$base"
  rm -rf "$chunkdir"; mkdir -p "$chunkdir"
  split -C "$CHUNK_SIZE" -d --additional-suffix=.log "$f" "$chunkdir/part." 2>/dev/null \
    || split -C "$CHUNK_SIZE" -d "$f" "$chunkdir/part."   # fallback if --additional-suffix unsupported
  echo "  chunks: $(ls -1 "$chunkdir" | wc -l)"

  # 2) scan the chunks -> JSON (authoritative, parseable without jq)
  json="$OUTDIR/$base.json"
  if ! trivy fs --scanners secret "${CONFIG_ARG[@]}" \
        --format json --output "$json" "$chunkdir" 2> "$OUTDIR/.trivy.err"; then
    echo "  ERROR scanning $base (left chunks in $chunkdir for inspection):" >&2
    sed 's/^/    /' "$OUTDIR/.trivy.err" | head -n 5 >&2
    n_err=$((n_err+1))
    continue   # not marked done -> retried next run
  fi

  # 3) human-readable table from the same JSON (no re-scan)
  txt="$OUTDIR/$base.txt"
  trivy convert --format table --output "$txt" "$json" 2>/dev/null || cp "$json" "$txt"

  # 4) findings? Trivy JSON puts each secret under a "RuleID"
  hits=$(grep -c '"RuleID"' "$json" 2>/dev/null)
  if [ "${hits:-0}" -gt 0 ]; then
    echo "  >>> FINDINGS: $hits secret match(es)  (see $txt)"
    printf '%s\t%s hits\n' "$base" "$hits" >> "$OUTDIR/.findings-index.txt"
    n_find=$((n_find+1))
  else
    echo "  clean (no matches)"
    n_clean=$((n_clean+1))
  fi

  # 5) record done and free the disk
  printf '%s\n' "$base" >> "$DONE_FILE"
  rm -rf "$chunkdir"
done

rm -f "$OUTDIR/.trivy.err"

echo
echo "============================================================"
echo "Summary"
echo "  logs with findings : $n_find"
echo "  clean logs         : $n_clean"
echo "  skipped (done)     : $n_skip"
echo "  errored            : $n_err"
echo "============================================================"
if [ "$n_find" -gt 0 ]; then
  echo "Logs with secret matches:"
  sed 's/^/  /' "$OUTDIR/.findings-index.txt"
  echo "Per-log reports (.txt/.json) are in $OUTDIR/"
fi
echo
echo "Re-run any time: finished logs are skipped. Errored logs are retried."
echo "NOTE: built-in Trivy rules target cloud/SaaS tokens. For infra creds"
echo "(sasl_password=, SNMP communities, dovecot hashes, JDBC...) add a"
echo "trivy-secret.yaml, or also run your own scan-ecs-logs-for-credentials.sh."
