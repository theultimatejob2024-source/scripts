#!/usr/bin/env bash
#
# restart_ecs_service.sh
#
# Restarts one or more ECS services, waits until they are all up and running
# again, and writes the result to a log file. If the services don't come back,
# it tries again, up to MAX_ATTEMPTS times, then logs a FAILURE.
#
# Same approach as the load balancer health check script: assume the IAM role,
# wait with a time limit, record each result, exit 0 (pass) or 1 (fail).

set -euo pipefail

## Settings - replace the placeholder before use
AWS_ROLE_ARN='<REDACTED_ROLE_ARN>'
AWS_SESSION_NAME="jenkins-ecs-service-restart"
AWS_REGION="eu-west-2"
MAX_ATTEMPTS=3

#Parameters
if [[ $# -lt 3 ]]; then
    echo "Usage: $0 <cluster> <log_file> <service1> [service2 ...]"
    echo "Eg: $0 <cluster> ecs_restart.log <service_a> <service_b>"
    exit 1
fi
cluster=$1
log_file=$2
shift 2
services=("$@")

## Functions

# Timestamped line to the console (Jenkins log) and to the log file
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "${log_file}"
}

assume_role() {
    echo "Assuming role: ${AWS_ROLE_ARN}" >&2
    local creds expiry
    creds=$(aws sts assume-role \
        --role-arn "${AWS_ROLE_ARN}" \
        --role-session-name "${AWS_SESSION_NAME}" \
        --duration-seconds 3600 \
        --output text \
        --query '[Credentials.AccessKeyId,Credentials.SecretAccessKey,Credentials.SessionToken,Credentials.Expiration]') || return 1

    read -r AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN expiry <<< "${creds}"
    export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
    export AWS_DEFAULT_REGION="${AWS_REGION}"
    echo "Token expires at: ${expiry}" >&2
}

# 1. Restart = force a new deployment. ECS starts new tasks and then stops
#    the old ones, so the service stays available during the restart.
restart_services() {
    local service
    for service in "${services[@]}"; do
        log "Restarting ${service} in cluster ${cluster}..."
        if ! aws ecs update-service --cluster "${cluster}" --service "${service}" \
                --force-new-deployment --query 'service.serviceName' --output text >/dev/null; then
            log "ERROR: restart request failed for ${service}"
            return 1
        fi
    done
}

# 2. Check every service is up: ACTIVE, at least one task wanted, running
#    count equals desired count, and the old deployment is gone.
#    Compares exact numbers (no grep), so it can't falsely pass.
all_running() {
    local service status desired running deployments result=0
    for service in "${services[@]}"; do
        read -r status desired running deployments <<< "$(aws ecs describe-services \
            --cluster "${cluster}" --services "${service}" \
            --query 'services[0].[status, desiredCount, runningCount, length(deployments)]' \
            --output text)"
        log "${service}: status=${status} desired=${desired} running=${running} deployments=${deployments}"
        if [[ "${status}" != "ACTIVE" || "${desired}" == "0" || \
              "${running}" != "${desired}" || "${deployments}" != "1" ]]; then
            result=1
        fi
    done
    return "${result}"
}

########
# Main
#########

if [[ "${AWS_ROLE_ARN}" == *"<REDACTED"* ]]; then
    echo "ERROR: fill in AWS_ROLE_ARN in the Settings section first."
    exit 1
fi

log "===== ECS restart started: cluster=${cluster} services=${services[*]} ====="

if ! assume_role; then
    log "FAILURE: could not assume the AWS role."
    exit 1
fi

for attempt in $(seq 1 "${MAX_ATTEMPTS}"); do
    log "Attempt ${attempt}/${MAX_ATTEMPTS}"

    if restart_services; then
        # 3. Wait until all services are stable. Built-in AWS CLI waiter:
        #    checks every 15s and gives up after about 10 minutes.
        log "Waiting for services to become available..."
        aws ecs wait services-stable --cluster "${cluster}" --services "${services[@]}" \
            || log "Services did not become stable within the wait time."

        # 4. Confirm and log the final state
        if all_running; then
            log "SUCCESS: all services are up and running (attempt ${attempt})."
            exit 0
        fi
    fi

    log "Attempt ${attempt} failed."
done

# 6. Still not back after all attempts
log "FAILURE: services not up and running after ${MAX_ATTEMPTS} attempts."
exit 1
