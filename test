#!/usr/bin/env bash
# redact.sh - make a redacted copy of a file before sharing it.
# Usage: ./redact.sh <input-file> [output-file]
# The original file is never changed.

set -euo pipefail

if [[ $# -lt 1 || ! -f "$1" ]]; then
  echo "Usage: $0 <input-file> [output-file]" >&2
  exit 1
fi

in="$1"
if [[ -n "${2:-}" ]]; then
  out="$2"
elif [[ "$(basename "$in")" == *.* ]]; then
  out="${in%.*}.redacted.${in##*.}"
else
  out="${in}.redacted"
fi

command -v perl >/dev/null || { echo "perl is required" >&2; exit 1; }

perl -0777 -pe '
  # Private keys and certificates (whole block)
  s/-----BEGIN [A-Z ]*-----.*?-----END [A-Z ]*-----/<REDACTED_KEY_BLOCK>/gs;
  # AWS access key IDs
  s/\b(?:AKIA|ASIA)[A-Z0-9]{16}\b/<REDACTED_AWS_KEY>/g;
  # user:password inside URLs
  s{(://)[^/\s:@"\x27]+:[^/\s@"\x27]+@}{$1<REDACTED_CREDS>@}g;
  # Bearer tokens
  s/(Bearer\s+)[A-Za-z0-9._~+\/=-]+/$1<REDACTED>/gi;
  # Quoted values given to secret-looking names, e.g. token: "abc", password = "abc"
  s/(\b\w*(?:password|passwd|pwd|secret|token|api_?key|private_?key)\w*["\x27]?\s*[:=]\s*)(["\x27])[^"\x27\n]*\2/$1$2<REDACTED>$2/gi;
  # Secret-looking query string values, e.g. ?token=abc
  s/([?&](?:token|key|secret|password|sig|signature)\w*=)[^&\s"\x27]+/$1<REDACTED>/gi;
  # AWS ARNs
  s/arn:aws[\w-]*:[^\s"\x27,)]*/<REDACTED_ARN>/g;
  # S3 paths
  s{s3://[^\s"\x27]+}{<REDACTED_S3>}g;
  # URLs
  s{https?://[^\s"\x27<>)]+}{<REDACTED_URL>}g;
  # Internal hostnames
  s/\b[\w.-]+\.(?:local|internal|gov\.uk)\b/<REDACTED_HOST>/gi;
  # Email addresses
  s/\b[\w.+-]+@[\w-]+(?:\.[\w-]+)+\b/<REDACTED_EMAIL>/g;
  # IP addresses
  s/\b(?:\d{1,3}\.){3}\d{1,3}\b/<REDACTED_IP>/g;
  # 12-digit AWS account IDs
  s/\b\d{12}\b/<REDACTED_ACCOUNT_ID>/g;
  # Long random-looking strings (32+ characters)
  s/\b[A-Za-z0-9+_=-]{32,}\b/<REDACTED_LONG_STRING>/g;
' "$in" > "$out"

changed=$(diff "$in" "$out" | grep -c '^>' || true)
echo "Redacted copy written to: $out ($changed lines changed)"
echo
echo "Lines still worth a manual look (names, usernames, anything missed):"
grep -niE 'password|passwd|secret|token|key|auth|user|@' "$out" | grep -v '<REDACTED' || echo "  none found"
