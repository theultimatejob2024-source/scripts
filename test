START_MS=$(date -u -d '30 minutes ago' +%s000); END_MS=$(date -u +%s000)
for p in "Received HTTP Message" "Received JMS Message" "ERROR" "Exception"; do echo "== $p =="; aws logs filter-log-events --log-group-name "$LOG_GROUP" --start-time "$START_MS" --end-time "$END_MS" --filter-pattern "\"$p\"" --query 'events[].logStreamName' --output text | tr '\t' '\n' | sort | uniq -c; done
