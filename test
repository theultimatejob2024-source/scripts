# Set every service to the given desired count
scale_services() {
    local count="$1" service
    for service in "${services[@]}"; do
        log "Setting ${service} desired count to ${count}..."
        aws ecs update-service --cluster "${cluster}" --service "${service}" \
            --desired-count "${count}" --query 'service.serviceName' --output text >/dev/null \
            || { log "ERROR: could not set ${service} to ${count}"; return 1; }
    done
}

# Restart: 0 -> wait -> 1 -> wait -> DESIRED_COUNT -> wait
restart_services() {
    # 1. Stop all tasks
    scale_services 0 || return 1
    wait_for_running_count 0 "Stopping" || return 1
    log "All tasks stopped. Waiting ${STEP_WAIT}s..."
    sleep "${STEP_WAIT}"

    # 2. Bring up one task
    scale_services 1 || return 1
    wait_for_running_count 1 "Starting first task" || return 1
    log "First task running. Waiting ${STEP_WAIT}s..."
    sleep "${STEP_WAIT}"

    # 3. Bring up the rest
    scale_services "${DESIRED_COUNT}" || return 1
    wait_for_running_count "${DESIRED_COUNT}" "Starting remaining tasks" || return 1
    log "All ${DESIRED_COUNT} tasks running. Waiting ${STEP_WAIT}s..."
    sleep "${STEP_WAIT}"
}
