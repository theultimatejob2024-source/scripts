#!/usr/bin/env bash
#
# triage-trivy-findings.sh
#
# Turn a pile of per-log Trivy JSON results into a short, deduped, ranked list
# of DISTINCT findings so you can tell genuine credential exposure from noise.
#
# Trivy redacts the secret value (****) in its output, so this tool shows you
# WHERE and WHICH RULE (deduped, ranked by rule confidence); to see the real
# value and confirm, use the `reveal` subcommand to grep the source log.
#
# Pure Bash + awk/grep/sed. No jq (parses Trivy's pretty-printed JSON directly).
#
# USAGE
#   ./triage-trivy-findings.sh [RESULTS_DIR]                 # triage report
#   ./triage-trivy-findings.sh reveal <source-log> [LOGDIR]  # real lines from source
#
#   RESULTS_DIR default: trivy-results   (holds <log>.log.json files)
#   LOGDIR      default: cwlogs          (holds the original <log>.log files)
# -----------------------------------------------------------------------------
RESULTS_DIR="${RESULTS_DIR:-trivy-results}"
LOGDIR="${LOGDIR:-cwlogs}"
US=$'\037'

# Rules that are broad/noisy by design -> findings go to the REVIEW-LATER bucket.
NOISY_RULES="infra-generic-password infra-generic-secret infra-env-inline-secret infra-generic-keyname-secret infra-generic-cli-password-flag infra-json-quoted-secret infra-prometheus-credentials infra-generic-uri-cred"

is_noisy() { case " $NOISY_RULES " in *" $1 "*) return 0;; esac; return 1; }

# -----------------------------------------------------------------------------
# Extract findings from Trivy's (pretty-printed) secret JSON into TSV:
#   SRC \t RuleID \t Severity \t StartLine \t Match
# Each of RuleID/Severity/StartLine/Match appears once per secret at its own
# line in pretty JSON, and only at secret level (Code block uses different keys).
# -----------------------------------------------------------------------------
extract_one() {   # $1 = json file
  local src; src="$(basename "$1")"; src="${src%.json}"
  awk -v SRC="$src" -v US="$US" '
    function val(s) {              # pull value after the first colon
      sub(/^[^:]*:[[:space:]]*/, "", s)
      sub(/,[[:space:]]*$/, "", s)
      gsub(/^"|"$/, "", s)
      gsub(/\\"/, "\"", s)
      return s
    }
    /"RuleID"[[:space:]]*:/ {
      if (have) { print SRC US rid US sev US line US match_ }   # flush prev
      rid=val($0); sev=""; line=""; match_=""; have=1; next
    }
    /"Severity"[[:space:]]*:/ { if (have) sev=val($0); next }
    /"StartLine"[[:space:]]*:/ { if (have && line=="") line=val($0); next }
    /"Match"[[:space:]]*:/ { if (have) match_=val($0); next }
    END { if (have) print SRC US rid US sev US line US match_ }
  ' "$1"
}

normalize_match() {   # collapse redaction runs + whitespace so dups fold together
  sed -E 's/\*{2,}/\*\*\*/g; s/[[:space:]]+/ /g; s/^ //; s/ $//'
}

# -----------------------------------------------------------------------------
# Triage report
# -----------------------------------------------------------------------------
triage() {
  [ -d "$RESULTS_DIR" ] || { echo "ERROR: results dir not found: $RESULTS_DIR" >&2; exit 1; }
  shopt -s nullglob; local jsons=("$RESULTS_DIR"/*.json); shopt -u nullglob
  [ "${#jsons[@]}" -gt 0 ] || { echo "No *.json in $RESULTS_DIR" >&2; exit 1; }

  local ALL; ALL="$(mktemp)"
  for j in "${jsons[@]}"; do extract_one "$j"; done > "$ALL"

  local total; total=$(grep -c . "$ALL")
  if [ "$total" -eq 0 ]; then echo "No findings in $RESULTS_DIR."; rm -f "$ALL"; return; fi

  # build deduped records: key = RuleID + normalized Match
  # emit: count <TAB> RuleID <TAB> Severity <TAB> nsrc <TAB> normMatch <TAB> srcs
  local DEDUP; DEDUP="$(mktemp)"
  awk -v US="$US" 'BEGIN{FS=US}
    {
      src=$1; rid=$2; sev=$3; m=$5
      # normalize match
      gsub(/\*\*+/,"***",m); gsub(/[ \t]+/," ",m); sub(/^ /,"",m); sub(/ $/,"",m)
      key=rid US m
      cnt[key]++; sevk[key]=sev; ridk[key]=rid; mk[key]=m
      if (!((key SUBSEP src) in seen)) { seen[key SUBSEP src]=1; nsrc[key]++; srcs[key]=srcs[key]==""?src:srcs[key]","src }
    }
    END{ for (k in cnt) printf "%d%s%s%s%s%s%d%s%s%s%s\n", cnt[k],US,ridk[k],US,sevk[k],US,nsrc[k],US,mk[k],US,srcs[k] }
  ' "$ALL" > "$DEDUP"

  local n_distinct; n_distinct=$(grep -c . "$DEDUP")

  # severity weight for sorting
  weight() { case "$1" in CRITICAL) echo 0;; HIGH) echo 1;; MEDIUM) echo 2;; LOW) echo 3;; *) echo 4;; esac; }

  print_bucket() {   # $1 = "review" (specific) or "noise" (generic)
    local want="$1" row cnt rid sev nsrc m srcs w
    while IFS="$US" read -r cnt rid sev nsrc m srcs; do
      if [ "$want" = "noise" ]; then is_noisy "$rid" || continue; else is_noisy "$rid" && continue; fi
      w=$(weight "$sev")
      printf '%d%s%06d%s%s%s%s%s%d%s%s%s%s\n' "$w" "$US" "$cnt" "$US" "$sev" "$US" "$rid" "$US" "$nsrc" "$US" "$m" "$US" "$srcs"
    done < "$DEDUP" | sort -t"$US" -k1,1n -k2,2nr | while IFS="$US" read -r w cnt sev rid nsrc m srcs; do
      cnt=$((10#$cnt))
      printf '  [%s] %s  (x%d across %d log%s)\n' "$sev" "$rid" "$cnt" "$nsrc" "$([ "$nsrc" -ne 1 ] && echo s)"
      printf '      match: %s\n' "$m"
      printf '      logs : %s\n' "$srcs"
    done
  }

  {
    echo "============================================================"
    echo "Trivy findings triage"
    echo "  result files : ${#jsons[@]}   raw findings: $total   distinct: $n_distinct"
    echo "============================================================"
    echo
    echo "### REVIEW THESE — specific rules, higher confidence ###"
    echo "(distinct findings; validate the value via: $0 reveal <log>)"
    echo
    print_bucket review
    echo
    echo "### LIKELY NOISE — broad/generic rules, skim only ###"
    echo
    print_bucket noise
    echo
    echo "### per-rule totals (raw) ###"
    awk -v US="$US" 'BEGIN{FS=US}{c[$2]++} END{for(k in c) printf "  %6d  %s\n", c[k], k}' "$ALL" | sort -rn
  }

  rm -f "$ALL" "$DEDUP"
}

# -----------------------------------------------------------------------------
# reveal: show the REAL (un-redacted) candidate lines from the source log
# -----------------------------------------------------------------------------
reveal() {
  local src="$1" dir="${2:-$LOGDIR}"
  [ -n "$src" ] || { echo "usage: $0 reveal <source-log> [LOGDIR]" >&2; exit 1; }
  local f="$dir/$src"
  [ -f "$f" ] || f="$dir/${src%.json}"       # tolerate passing the .json name
  [ -f "$f" ] || { echo "ERROR: source log not found: $dir/$src" >&2; exit 1; }
  echo "Real candidate lines in $f (masked-only lines filtered out):"
  echo "------------------------------------------------------------"
  grep -anE '(\{(SSHA|CRYPT|MD5|SHA)[0-9]*\}|\$(apr1|[0-9a-z]+)\$|://[^/ :@]+:[^/ :@]+@|(password|passwd|secret|token|rootpw|bindpw|client[_-]secret)[[:space:]:=]+[^ *[:space:]])' "$f" \
    | grep -vE '\*{3,}' \
    | head -n 60
  echo "------------------------------------------------------------"
  echo "(showing up to 60; refine with: grep -anE '<pattern>' \"$f\")"
}

# -----------------------------------------------------------------------------
case "${1:-}" in
  reveal) shift; reveal "$@" ;;
  ""|triage) [ "${1:-}" = "triage" ] && shift; [ -n "${1:-}" ] && RESULTS_DIR="$1"; triage ;;
  *) RESULTS_DIR="$1"; triage ;;
esac
