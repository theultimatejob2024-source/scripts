#!/usr/bin/env bash
#
# triage-trivy-findings.sh
#
# Default run: for every high-confidence Trivy finding, show the ACTUAL value
# pulled from the source log — trimmed to just the match, unmasked, deduped.
# Noise (broad/generic rules) hidden unless asked for.
#
#   MODE=cred (default) -> credential value extraction
#   MODE=pii            -> biometric/biographic PII value extraction
#
# Pure Bash + awk/grep/sed (no jq).
#
# USAGE
#   ./triage-trivy-findings.sh [RESULTS_DIR]              # reveal exposures (default)
#   MODE=pii RESULTS_DIR=pii-results ./triage-trivy-findings.sh
#   ./triage-trivy-findings.sh noise [RESULTS_DIR]        # show skipped noisy bucket
#   ./triage-trivy-findings.sh reveal <log> [LOGDIR]      # one log's real values
#
#   RESULTS_DIR default: trivy-results   LOGDIR default: cwlogs
# -----------------------------------------------------------------------------
RESULTS_DIR="${RESULTS_DIR:-trivy-results}"
LOGDIR="${LOGDIR:-cwlogs}"
MODE="${MODE:-cred}"
US=$'\037'
TRIM="${TRIM:-120}"
MAX_PER_LOG="${MAX_PER_LOG:-50}"

CRED_NOISY="infra-generic-password infra-generic-secret infra-env-inline-secret infra-generic-keyname-secret infra-generic-cli-password-flag infra-json-quoted-secret infra-prometheus-credentials infra-generic-uri-cred"
PII_NOISY="pii-demographic-field pii-biometric-keyword"
DNA_NOISY="pii-dna-genetic-term pii-dna-snp-id"
case "$MODE" in pii) NOISY_RULES="$PII_NOISY";; dna) NOISY_RULES="$DNA_NOISY";; *) NOISY_RULES="$CRED_NOISY";; esac
is_noisy() { case " $NOISY_RULES " in *" $1 "*) return 0;; esac; return 1; }

# credential value extractor (tightened)
CRED_PAT='(\{(ssha|smd5|sha|md5|crypt)[0-9]*\}[A-Za-z0-9+/=]{6,}|\$(apr1|1|5|6|2[abxy]?|y|gy|7|md5|sha256|sha512)\$[^[:space:]]{6,}|eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+|gl(sa|c)_[A-Za-z0-9_=+/-]+|[a-z][a-z0-9+.-]*://[^/[:space:]:@]+:[^/[:space:]:@]+@[^[:space:]]*|(password|passwd|pwd|passphrase|secret|rootpw|bindpw|sasl_password|client[_-]secret|api[_-]?key|bearer_token|admin_password|key-?store-?password|basicauthpassword)[[:space:]]*[:=]+[[:space:]]*[^[:space:]]{4,}|(rocommunity|rwcommunity|community)[[:space:]]+[a-z][a-z0-9_-]{3,})'

# PII value extractor (biometric + biographic), value-focused
PII_PAT='([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}|\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b|\b(4[0-9]{12}([0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(011|5[0-9]{2})[0-9]{12})\b|\b[A-Z]{5}[0-9]{4}[A-Z]\b|\b[2-9][0-9]{3}[[:space:]][0-9]{4}[[:space:]][0-9]{4}\b|\b[A-CEGHJ-PR-TW-Z]{2}[0-9]{6}[A-D]\b|passport[[:space:]]*(no\.?|number|num|#)?[[:space:]]*[:=#]?[[:space:]]*[A-Z0-9]{6,9}|(phone|mobile|msisdn|tel|contact)[[:space:]]*(no|number|#)?[[:space:]]*[:=][[:space:]]*\+?[0-9][0-9[:space:]().-]{7,}|(dob|date[_ ]?of[_ ]?birth|birth[_-]?date)[[:space:]]*[:=][[:space:]]*[^[:space:]]+|(driver.?s?[_ ]?licen[sc]e|driving[_ ]?licen[sc]e|dl[_ ]?(no|number|#))[[:space:]]*[:=#]?[[:space:]]*[A-Z0-9]{5,}|(nationality|gender|marital[_ -]?status|place[_ -]?of[_ -]?birth|mother[_ -]?s?[_ -]?maiden)[[:space:]]*[:=][[:space:]]*[^[:space:]]+|(fingerprint|face|iris|retina|palm|voice)[_-]?(template|image|encoding|embedding|scan|data|record|sample)[[:space:]]*[:=][[:space:]]*[^[:space:]]+|voice[_-]?print|palm[_-]?print|face[_-]?id|iris[_ -]?scan|minutiae|\.wsq\b|ISO[/ ]?19794|NIST[- ]?ITL|CBEFF)'

# DNA / genetic-reference extractor (value-focused)
DNA_PAT='([A-Za-z0-9_./-]*\.(vcf|gvcf|bcf|fastq|fq|bam|cram|sam)(\.gz)?|\brs[0-9]{3,}\b|\b(D[0-9]{1,2}S[0-9]{2,4}|vWA|FGA|TH01|CSF1PO|TPOX|SE33|amelogenin)\b|((dna|str)[_-]?profile|genotype|alleles?)[[:space:]]*[:=][[:space:]]*[^[:space:]]+|\b(genomic|genome|codis|biosample|dna[_-]?sequence)\b|\b[acgtn]{20,}\b)'

reveal_values() {
  local f="$1" pat="$CRED_PAT"
  [ "$MODE" = "pii" ] && pat="$PII_PAT"
  [ "$MODE" = "dna" ] && pat="$DNA_PAT"
  grep -aoiE "$pat" "$f" \
    | grep -avE '\*{3,}|REDACTED|=\$\{|<[^>]*>' \
    | sed -E "s/^(.{0,$TRIM}).*\$/\1/" \
    | sort -u \
    | head -n "$MAX_PER_LOG"
}

extract_one() {
  local src; src="$(basename "$1")"; src="${src%.json}"
  awk -v SRC="$src" -v US="$US" '
    function val(s){ sub(/^[^:]*:[[:space:]]*/,"",s); if(s ~ /^"/){ sub(/^"/,"",s); sub(/".*$/,"",s) } else { sub(/[^0-9].*$/,"",s) } return s }
    /"RuleID"[[:space:]]*:/    { if(have) print SRC US rid US sev US line US m; rid=val($0); sev=""; line=""; m=""; have=1; next }
    /"Severity"[[:space:]]*:/  { if(have) sev=val($0); next }
    /"StartLine"[[:space:]]*:/ { if(have && line=="") line=val($0); next }
    /"Match"[[:space:]]*:/     { if(have) m=val($0); next }
    END { if(have) print SRC US rid US sev US line US m }
  ' "$1"
}

gather() {
  shopt -s nullglob; local jsons=("$RESULTS_DIR"/*.json); shopt -u nullglob
  [ "${#jsons[@]}" -gt 0 ] || return 1
  local j; for j in "${jsons[@]}"; do extract_one "$j"; done
}

triage_reveal() {
  [ -d "$RESULTS_DIR" ] || { echo "ERROR: results dir not found: $RESULTS_DIR" >&2; exit 1; }
  local ALL; ALL="$(mktemp)"; gather > "$ALL" || { echo "No *.json in $RESULTS_DIR" >&2; rm -f "$ALL"; exit 1; }

  local REV; REV="$(mktemp)"
  awk -v US="$US" 'BEGIN{FS=US;OFS=US}{print $1,$2,$3,$5}' "$ALL" > "$REV.tmp"
  : > "$REV"
  while IFS="$US" read -r src rid sev m; do is_noisy "$rid" || printf '%s%s%s%s%s%s%s\n' "$src" "$US" "$rid" "$US" "$sev" "$US" "$m" >> "$REV"; done < "$REV.tmp"
  rm -f "$REV.tmp"

  local n_rev n_noise n_logs
  n_rev=$(grep -c . "$REV")
  n_noise=$(awk -v US="$US" 'BEGIN{FS=US}{print $2}' "$ALL" | while read -r r; do is_noisy "$r" && echo x; done | grep -c .)
  n_logs=$(cut -d"$US" -f1 "$REV" | sort -u | grep -c .)

  echo "============================================================"
  echo "Found $(case "$MODE" in pii) echo PII;; dna) echo "DNA/genetic references";; *) echo credentials;; esac) — values from source logs  [MODE=$MODE]"
  echo "  source logs with findings: $n_logs   (noise hidden: $n_noise — see '$0 noise')"
  echo "============================================================"

  if [ "$n_rev" -eq 0 ]; then echo; echo "No high-confidence findings."; rm -f "$ALL" "$REV"; return; fi

  cut -d"$US" -f1 "$REV" | sort -u | while IFS= read -r src; do
    [ -n "$src" ] || continue
    echo
    echo ">>> $src"
    awk -v US="$US" -v s="$src" 'BEGIN{FS=US}$1==s{print "    - "$3" "$2}' "$REV" | sort -u
    echo "    found:"
    local f="$LOGDIR/$src"
    if [ -f "$f" ]; then
      reveal_values "$f" | sed 's/^/      /'
    else
      echo "      (source log not in $LOGDIR — showing Trivy's redacted match instead)"
      awk -v US="$US" -v s="$src" 'BEGIN{FS=US}$1==s{print "      "$4}' "$REV" | sort -u | sed -E "s/^(.{0,$((TRIM+6))}).*/\1/"
    fi
  done

  echo
  echo "------------------------------------------------------------"
  echo "Values above are real (unmasked) and deduped. Keep them off chat/tickets."
  rm -f "$ALL" "$REV"
}

show_noise() {
  local ALL; ALL="$(mktemp)"; gather > "$ALL" || { echo "No *.json in $RESULTS_DIR" >&2; rm -f "$ALL"; exit 1; }
  echo "Noisy (broad-rule) findings — counts per rule, skim only:"
  awk -v US="$US" 'BEGIN{FS=US}{print $2}' "$ALL" | while read -r r; do is_noisy "$r" && echo "$r"; done \
    | sort | uniq -c | sort -rn | awk '{printf "  %6d  %s\n",$1,$2}'
  rm -f "$ALL"
}

reveal_one() {
  local src="$1" dir="${2:-$LOGDIR}"
  [ -n "$src" ] || { echo "usage: $0 reveal <source-log> [LOGDIR]" >&2; exit 1; }
  local f="$dir/$src"; [ -f "$f" ] || f="$dir/${src%.json}"
  [ -f "$f" ] || { echo "ERROR: source log not found: $dir/$src" >&2; exit 1; }
  echo "Found in $f  [MODE=$MODE]:"
  reveal_values "$f" | sed 's/^/  /'
}

case "${1:-}" in
  reveal)       shift; reveal_one "$@" ;;
  noise)        shift; [ -n "${1:-}" ] && RESULTS_DIR="$1"; show_noise ;;
  ""|triage)    [ "${1:-}" = "triage" ] && shift; [ -n "${1:-}" ] && RESULTS_DIR="$1"; triage_reveal ;;
  *)            RESULTS_DIR="$1"; triage_reveal ;;
esac
