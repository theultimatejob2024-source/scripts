TASKS=$(aws ecs list-tasks --cluster "$CLUSTER" --service-name "$SERVICE" --query 'taskArns' --output text)

aws ecs describe-tasks --cluster "$CLUSTER" --tasks $TASKS \
  --query 'tasks[].{id:taskArn,started:startedAt,status:lastStatus,health:healthStatus,az:availabilityZone,ip:attachments[0].details[?name==`privateIPv4Address`].value|[0],taskDef:taskDefinitionArn}' \
  --output table

aws elbv2 describe-target-health --target-group-arn "<TARGET_GROUP_ARN>" --output table


aws elbv2 describe-target-groups --target-group-arns "<TARGET_GROUP_ARN>" \
  --query 'TargetGroups[0].{protocol:Protocol,port:Port,hcPath:HealthCheckPath,hcPort:HealthCheckPort,interval:HealthCheckIntervalSeconds,timeout:HealthCheckTimeoutSeconds,healthyThreshold:HealthyThresholdCount,unhealthyThreshold:UnhealthyThresholdCount,matcher:Matcher.HttpCode}'


aws cloudwatch get-metric-statistics --namespace AWS/ApplicationELB \
  --metric-name HTTPCode_Target_5XX_Count \
  --dimensions Name=LoadBalancer,Value=app/<alb-name>/<alb-id> \
  --start-time <START, e.g. 2026-11-16T09:00:00Z> --end-time <END> \
  --period 300 --statistics Sum --output table

aws elbv2 describe-load-balancer-attributes --load-balancer-arn "<ALB_ARN>" \
  --query "Attributes[?starts_with(Key,'access_logs')]"

aws ecs describe-task-definition --task-definition "<TASK_DEF_ARN from step 1>" \
  --query 'taskDefinition.containerDefinitions[].{name:name,logConfig:logConfiguration}'

aws logs tail "<LOG_GROUP>" --log-stream-name-prefix "<stream-prefix>/<container-name>/<BAD_TASK_ID>" --since 1h

