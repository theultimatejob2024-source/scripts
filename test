#!/usr/bin/env bash
#
# download-logs-batch.sh
#
# Download the last N days of events for a list of CloudWatch log groups, one
# file per group. Resumable: each group is marked done only on a clean finish,
# so if temporary credentials expire part-way through you just refresh them and
# re-run — already-completed groups are skipped, and a half-downloaded group is
# redone from scratch (never left partial and marked done).
#
# Pure aws CLI + coreutils. No Python, no jq.
#
# USAGE
#   ./download-logs-batch.sh                 # uses the defaults below
#   LOG_GROUP_FILE=groups.txt DAYS=31 ./download-logs-batch.sh
#
# INPUT
#   LOG_GROUP_FILE: one log group name per line. Blank lines and #comments
#   ignored. A line may optionally be "<group><TAB><stream-name-prefix>" to
#   scope a large group (e.g. /dna/instance-logs) and avoid throttling.
# -----------------------------------------------------------------------------
LOG_GROUP_FILE="${LOG_GROUP_FILE:-log_groups.txt}"
OUTDIR="${OUTDIR:-cwlogs}"
DAYS="${DAYS:-31}"
REGION="${REGION:-}"                       # e.g. eu-west-1; blank = CLI default
DONE_FILE="${DONE_FILE:-$OUTDIR/.download-done.txt}"
FAILED_FILE="${FAILED_FILE:-$OUTDIR/.download-failed.txt}"

export AWS_RETRY_MODE="${AWS_RETRY_MODE:-adaptive}"
export AWS_MAX_ATTEMPTS="${AWS_MAX_ATTEMPTS:-10}"

# -----------------------------------------------------------------------------
mkdir -p "$OUTDIR"
touch "$DONE_FILE" "$FAILED_FILE"

if [ ! -f "$LOG_GROUP_FILE" ]; then
  echo "ERROR: log group file not found: $LOG_GROUP_FILE" >&2
  exit 1
fi

# GNU date (Linux). On macOS use: date -v-"${DAYS}"d +%s
START_MS=$(( $(date -d "$DAYS days ago" +%s) * 1000 ))
NOW_MS=$(( $(date +%s) * 1000 ))

REGION_ARG=(); [ -n "$REGION" ] && REGION_ARG=(--region "$REGION")

# strings in CLI stderr that mean "your credentials are gone" -> stop, don't
# churn through every remaining group failing identically.
EXPIRY_RE='ExpiredToken|ExpiredTokenException|RequestExpired|InvalidClientTokenId|UnrecognizedClientException|security token.*(expired|invalid)|The provided token has expired|credentials.*(expired|not|invalid)'

safe_name() { printf '%s' "$1" | sed 's#[/ ]#_#g; s/\t/__/g'; }

# counters
n_done=0; n_skip=0; n_fail=0

echo "Batch download: last $DAYS days  (since epoch-ms $START_MS)"
echo "Groups file : $LOG_GROUP_FILE"
echo "Output dir  : $OUTDIR"
echo "Done marker : $DONE_FILE"
echo

while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in ''|\#*) continue ;; esac
  # trim trailing whitespace/CR
  line="$(printf '%s' "$line" | sed 's/[[:space:]]*$//')"
  [ -z "$line" ] && continue

  # optional tab-separated stream prefix
  GROUP="${line%%$'\t'*}"
  if [ "$GROUP" != "$line" ]; then PREFIX="${line#*$'\t'}"; else PREFIX=""; fi

  SAFE="$(safe_name "$line")"
  OUTFILE="$OUTDIR/$SAFE.log"
  PARTFILE="$OUTDIR/$SAFE.partial"

  # ---- resume check: done AND the file is actually present -------------------
  if grep -Fxq -- "$line" "$DONE_FILE" && [ -f "$OUTFILE" ]; then
    echo "skip (done): $line"
    n_skip=$((n_skip+1))
    continue
  fi

  echo ">> downloading: $GROUP ${PREFIX:+(prefix: $PREFIX)}"

  PREFIX_ARG=(); [ -n "$PREFIX" ] && PREFIX_ARG=(--log-stream-name-prefix "$PREFIX")
  ERR="$OUTDIR/.err.$$"

  aws "${REGION_ARG[@]}" logs filter-log-events \
      --log-group-name "$GROUP" \
      "${PREFIX_ARG[@]}" \
      --start-time "$START_MS" \
      --end-time "$NOW_MS" \
      --query 'events[].message' \
      --output text \
      > "$PARTFILE" 2> "$ERR"
  rc=$?

  if [ "$rc" -eq 0 ]; then
    # clean finish -> commit: rename, then record done
    mv -f "$PARTFILE" "$OUTFILE"
    printf '%s\n' "$line" >> "$DONE_FILE"
    # drop any stale failed-entry for this line
    grep -Fxv -- "$line" "$FAILED_FILE" > "$FAILED_FILE.tmp" 2>/dev/null \
      && mv -f "$FAILED_FILE.tmp" "$FAILED_FILE"
    echo "   done: $(wc -l < "$OUTFILE") lines -> $OUTFILE"
    n_done=$((n_done+1))
    rm -f "$ERR"
    continue
  fi

  # non-zero: is it credential expiry? then stop cleanly so a re-run resumes.
  rm -f "$PARTFILE"
  if grep -qiE "$EXPIRY_RE" "$ERR"; then
    echo >&2
    echo "=============================================================" >&2
    echo "CREDENTIALS EXPIRED while on: $line" >&2
    sed 's/^/   /' "$ERR" | head -n 3 >&2
    echo "-------------------------------------------------------------" >&2
    echo "Refresh your temporary credentials and re-run the SAME command." >&2
    echo "$n_done completed this run are recorded; they will be skipped." >&2
    echo "=============================================================" >&2
    rm -f "$ERR"
    exit 2
  fi

  # other error (throttling exhausted, access denied on one group, etc.):
  # record it and keep going so one bad group doesn't block the rest.
  echo "   FAILED (rc=$rc): $line  — see below, continuing" >&2
  sed 's/^/     /' "$ERR" | head -n 3 >&2
  grep -Fxq -- "$line" "$FAILED_FILE" || printf '%s\n' "$line" >> "$FAILED_FILE"
  n_fail=$((n_fail+1))
  rm -f "$ERR"
done < "$LOG_GROUP_FILE"

echo
echo "============================================================"
echo "Run summary"
echo "  downloaded this run : $n_done"
echo "  skipped (already done): $n_skip"
echo "  failed (non-auth)   : $n_fail"
echo "  total recorded done : $(grep -c . "$DONE_FILE")"
[ "$n_fail" -gt 0 ] && echo "  failed groups listed in: $FAILED_FILE"
echo "============================================================"
echo
echo "Re-run any time: completed groups are skipped automatically."
[ "$n_fail" -gt 0 ] && echo "Failed (non-auth) groups are NOT marked done, so a re-run retries them."
